# --- Application ---
APP_NAME=FX Trend Bot
DB_PATH=/app/data/fxbot.sqlite3
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# paper | mt5_paper | oanda_practice | oanda_live
BROKER_MODE=paper
TRADING_ARMED=false
# Live mode has a second safety lock. Set this exact phrase only after practice testing.
ALLOW_LIVE_TRADING=NO

# --- OANDA v20 market data / execution ---
# Required for paper, oanda_practice, and oanda_live modes.
# Not required for mt5_paper.
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=
OANDA_BASE_URL_PRACTICE=https://api-fxpractice.oanda.com
OANDA_BASE_URL_LIVE=https://api-fxtrade.oanda.com
ACCOUNT_HOME_CURRENCY=JPY

# --- MT5 market data for local Windows paper trading ---
# mt5_paper uses MT5 for market data only and never sends MT5 orders.
MT5_TERMINAL_PATH=C:\Program Files\OANDA MetaTrader 5\terminal64.exe
MT5_INSTRUMENTS=USDJPY,EURUSD,GBPUSD,AUDUSD
MT5_TIMEOUT_MS=120000

# --- Strategy profile ---
# legacy_trend_v1 keeps the existing EMA200 / 55-day breakout behavior.
# adaptive_dual_regime_v1 is paper-only and selects at most one new trade per day.
STRATEGY_PROFILE=legacy_trend_v1
MARKET_DATA_CANDLE_COUNT=320

# Existing legacy strategy.
INSTRUMENTS=USD_JPY,EUR_USD,GBP_USD,AUD_USD
EMA_DAYS=200
EMA_SLOPE_LOOKBACK=20
ENTRY_CHANNEL_DAYS=55
EXIT_CHANNEL_DAYS=20
ATR_DAYS=20
ATR_STOP_MULTIPLE=2.0

# Adaptive profile example:
# STRATEGY_PROFILE=adaptive_dual_regime_v1
# MARKET_DATA_CANDLE_COUNT=3200
# MT5_INSTRUMENTS=USDJPY,EURUSD,GBPUSD,AUDUSD,NZDUSD,USDCAD,USDCHF,EURJPY,GBPJPY,AUDJPY
# INSTRUMENTS=USD_JPY,EUR_USD,GBP_USD,AUD_USD,NZD_USD,USD_CAD,USD_CHF,EUR_JPY,GBP_JPY,AUD_JPY
# Set currencies here on major CPI, employment, GDP, or central-bank decision days.
ENTRY_BLOCKED_CURRENCIES=
ADAPTIVE_FAST_EMA_DAYS=20
ADAPTIVE_MID_EMA_DAYS=50
ADAPTIVE_SLOW_EMA_DAYS=200
ADAPTIVE_SLOPE_LOOKBACK=10
ADAPTIVE_ADX_DAYS=14
ADAPTIVE_TREND_ADX=23
ADAPTIVE_RANGE_ADX=18
ADAPTIVE_BREAKOUT_DAYS=20
ADAPTIVE_BOLLINGER_DAYS=20
ADAPTIVE_RANGE_Z=1.8
ADAPTIVE_SCORE_MIN=75
ADAPTIVE_SCORE_MEDIUM=82
ADAPTIVE_SCORE_HIGH=90

# --- Legacy risk ---
RISK_PER_TRADE=0.0025
MAX_AGGREGATE_RISK=0.0075
MAX_GROSS_LEVERAGE=2.0
DRAWDOWN_HALF_RISK=0.08
DRAWDOWN_STOP=0.12

# --- Adaptive risk (paper-only) ---
ADAPTIVE_RISK_LOW=0.0040
ADAPTIVE_RISK_MEDIUM=0.0065
ADAPTIVE_RISK_HIGH=0.0080
ADAPTIVE_RANGE_RISK_CAP=0.0050
ADAPTIVE_MAX_OPEN_POSITIONS=2
ADAPTIVE_MAX_AGGREGATE_RISK=0.0130
ADAPTIVE_MAX_SINGLE_CURRENCY_RISK=0.0080
ADAPTIVE_MAX_GROSS_LEVERAGE=3.0
ADAPTIVE_MONTHLY_LOSS_LIMIT=0.05
ADAPTIVE_DRAWDOWN_REDUCE_1=0.04
ADAPTIVE_DRAWDOWN_REDUCE_2=0.07
ADAPTIVE_DRAWDOWN_STOP=0.10
ADAPTIVE_MAX_SPREAD_PIPS=3.0

# --- Paper execution assumptions ---
PAPER_INITIAL_BALANCE=1000000
PAPER_SPREAD_PIPS=1.0
PAPER_SLIPPAGE_PIPS=0.2

# Daily run at or after this UTC time, Monday-Friday.
# 22:15 UTC is after the New York 17:00 daily close year-round.
SCHEDULE_HOUR_UTC=22
SCHEDULE_MINUTE_UTC=15

# --- OpenAI test-result feedback ---
# Disabled by default. The app sends a redacted run summary and selected events only.
OPENAI_FEEDBACK_ENABLED=false
OPENAI_FEEDBACK_ALLOW_LIVE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_FEEDBACK_EVENT_LIMIT=100
OPENAI_FEEDBACK_MIN_INTERVAL_HOURS=20
OPENAI_TIMEOUT_SECONDS=60
